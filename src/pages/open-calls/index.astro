---
import faqs from '../../../content/faqs.json';
import Layout from '../../layouts/Layout.astro';import PageIntro from '../../components/PageIntro.astro';import calls from '../../../content/calls.json';import site from '../../../content/site.json';
const isOpen=(c:typeof calls[number])=>c.status==='open'&&(!c.deadline||Date.parse(c.deadline)>Date.now())&&!!c.submissionUrl;
const active=calls.filter(isOpen), closed=calls.filter(c=>!isOpen(c));
---
<Layout structuredData={[{'@type':'FAQPage',mainEntity:faqs.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))}]} title="Open calls · Submit work" description="Find Burrito artist opportunities, submission briefs, and archived open calls."><PageIntro eyebrow="Artist opportunities" title="Open calls." text="Submit work for a Burrito exhibition or release. Each call lists its brief, accepted formats, and deadline." /><section class="wrap page-content">
{active.length===0&&<div class="empty-state"><div><span class="status">Between open calls</span><h2 style="margin-top:20px">No open calls<br/>right now.</h2></div><div><p>There isn’t a confirmed open call listed right now. Join the Burrito Bar or follow us on X for the next announcement.</p><a class="button" href={site.discord}>Join Discord ↗</a><a class="text-link" href={site.twitter} style="margin-left:20px">Follow on X ↗</a></div></div>}
{active.length>0&&<div class="call-list">{active.map(c=><article class="call-card" data-deadline={c.deadline}><div><span class="status">Open for submissions</span><h2>{c.title}</h2><p>{c.summary}</p></div><div><p>{c.deadlineLabel}</p><ul>{c.requirements.map(r=><li>{r}</li>)}</ul><p>Fee: {c.fee}</p><p>Rights: {c.rights}</p><a class="button submission-link" href={c.submissionUrl}>Submit your work ↗</a><p class="expired-notice" hidden>This call has now closed.</p></div></article>)}</div>}
<div class="section-heading"><div><p class="eyebrow">Previous opportunities</p><h2>Past open calls.</h2></div></div><div class="call-list">{closed.map(c=><article class="call-card"><div><span class="status">Closed</span><h3>{c.title}</h3><p>{c.summary}</p><p class="caption">{c.location} · {c.deadlineLabel}</p></div><div><p class="eyebrow">The original brief</p><ul>{c.requirements.map(r=><li>{r}</li>)}</ul><a class="text-link" href={`/exhibitions/${c.exhibition}/`}>See the exhibition ↗</a><a class="text-link" href={c.source}>Original call ↗</a></div></article>)}</div>
<div class="steps"><article><p class="eyebrow">01 / Find your fit</p><h3>Read the brief.</h3><p>Look for the theme, accepted formats, deadline, fees, and exhibition or release details.</p></article><article><p class="eyebrow">02 / Share the work</p><h3>Keep it simple.</h3><p>Use the submission link in the active call. Include your artist name, work links, and a way to reach you.</p></article><article><p class="eyebrow">03 / Stay connected</p><h3>Watch for updates.</h3><p>Selection and next steps belong to each call. Follow the announcement for the details.</p></article></div>
<section class="faq" aria-label="Submission questions"><h2>Submission questions</h2>{faqs.map(f=><details><summary>{f.q}</summary><p>{f.a}</p></details>)}</section>
</section></Layout>
<script>document.querySelectorAll<HTMLElement>('[data-deadline]').forEach(card=>{const deadline=card.dataset.deadline;if(deadline&&Date.parse(deadline)<=Date.now()){card.querySelector<HTMLElement>('.submission-link')?.setAttribute('hidden','');card.querySelector<HTMLElement>('.expired-notice')?.removeAttribute('hidden');const status=card.querySelector('.status');if(status)status.textContent='Closed';}});</script>
