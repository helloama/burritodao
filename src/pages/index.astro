---
import Layout from '../layouts/Layout.astro';
import ExhibitionCard from '../components/ExhibitionCard.astro';
import exhibitions from '../../content/exhibitions.json';
import artists from '../../content/artists.json';
import site from '../../content/site.json';
import calls from '../../content/calls.json';
const featured=exhibitions.find(e=>e.slug===site.featuredExhibition)||exhibitions[0];
const activeCalls=calls.filter(c=>c.status==='open' && (!c.deadline||Date.parse(c.deadline)>Date.now()) && c.submissionUrl);
---
<Layout>
  <section class="hero wrap">
    <div class="hero-copy"><p class="eyebrow"><span class="tiny-star" aria-hidden="true">✳</span> Online friends. Real-world connections.</p><h1>For artists.<br/>By artists<span class="red">.</span></h1><p class="hero-description">Art brings us together.<br/>We make room for it.</p><p class="muted hero-note">Exhibitions, releases, and good reasons to meet.</p><div class="hero-actions"><a class="button" href={`/exhibitions/${featured.slug}/`}>See the latest exhibition <span aria-hidden="true">↗</span></a><a class="text-link" href="/open-calls/">Submit work <span aria-hidden="true">↗</span></a></div><div class="hero-bottom"><span class="hand-star" aria-hidden="true">✳</span><p>A collective, a gathering,<br/>a little bit of everything.</p></div></div>
    <figure class="hero-art"><a href={`/exhibitions/${featured.slug}/`}><img src={featured.image} alt={featured.imageAlt} width="675" height="900" fetchpriority="high" /><span class="image-label">Latest exhibition <span aria-hidden="true">↗</span></span></a><figcaption><span>{featured.city} · {featured.subtitle}</span><span>{featured.credit}</span></figcaption></figure>
  </section>
  <div class="cities" aria-label="Exhibiting across cities and online"><span>From the timeline to the real world</span><p>New York <i>✳</i> Miami <i>✳</i> Denver <i>✳</i> Chicago <i>✳</i> Paris <i>✳</i> Everywhere</p></div>
  <section class="section wrap"><div class="section-heading"><div><p class="eyebrow">Out in the world / 01</p><h2>Made to be seen.<br/>Better together.</h2></div><a class="text-link" href="/exhibitions/">All exhibitions <span aria-hidden="true">↗</span></a></div><div class="exhibition-grid">{exhibitions.slice(0,3).map((e,i)=><ExhibitionCard exhibition={e} index={i}/>)}</div></section>
  <section class="manifesto wrap"><p class="eyebrow">A little about us</p><p class="manifesto-text">We met through art.<br/>We stayed for <span>the people.</span></p><div class="manifesto-bottom"><span class="outline-flower" aria-hidden="true">✳</span><div><p>Four friends from online art communities. Now a collective making space for emerging and established artists—on screens, in galleries, and around the same table.</p><a class="text-link" href="/about/">Meet Burrito <span aria-hidden="true">↗</span></a></div></div></section>
  <section class="section wrap"><div class="section-heading"><div><p class="eyebrow">The people behind the work / 02</p><h2>Artists first.<br/>Always.</h2></div><a class="text-link" href="/artists/">Meet the artists <span aria-hidden="true">↗</span></a></div><div class="artist-grid">{artists.map(a=><article class="artist-card"><a href={`/artists/${a.slug}/`}><div class="artist-image"><img src={a.image} alt={a.imageAlt} loading="lazy" width="600" height="700" /></div><div class="artist-name"><h3>{a.name}</h3><span aria-hidden="true">↗</span></div></a><p class="eyebrow">{a.practice}</p></article>)}</div></section>
  <section class="callout"><div class="wrap callout-inner"><div><p class="eyebrow">For the next thing / 03</p><h2>Your work.<br/>A new audience.</h2></div><div><span class="status">{activeCalls.length?'Submissions open':'Between open calls'}</span><p>Got something to share? Each call has its own brief. Check the details, send your work, and meet us there.</p><a class="button cream" href="/open-calls/">{activeCalls.length?'Find your next open call':'Explore open calls'} <span aria-hidden="true">↗</span></a><p class="small-note">Catch the next announcement in the Burrito Bar.</p></div></div></section>
  <section class="section wrap"><div class="section-heading"><div><p class="eyebrow">Off the wall / 04</p><h2>Art takes<br/>different forms.</h2></div><a class="text-link" href="/drops/">Drops & objects <span aria-hidden="true">↗</span></a></div><div class="object-feature"><a class="object-image" href="/drops/artist-card-packs/"><img src="/images/mtg.webp" alt="Burrito’s artist-designed MTG proxy card with artwork by emotionull" loading="lazy" width="900" height="900" /></a><div class="object-copy"><p class="eyebrow">Artist-made / Physical objects</p><h3>Shuffle the art.<br/>Deal in your friends.</h3><p>Artist-designed MTG proxies, made by the collective. From digital worlds to the cards in your hand.</p><a class="text-link" href="/drops/artist-card-packs/">Meet the card packs <span aria-hidden="true">↗</span></a><p class="image-credit">Card artwork by emotionull.</p></div></div></section>
  <section class="partner-strip wrap"><p>Have a space, an idea,<br/>or a reason to get together?</p><a class="text-link" href="/contact/">Partner / book us <span aria-hidden="true">↗</span></a></section>
</Layout>
