---
import Layout from '../layouts/Layout.astro';
import ExhibitionCard from '../components/ExhibitionCard.astro';
import exhibitions from '../../content/exhibitions.json';
import site from '../../content/site.json';
import calls from '../../content/calls.json';
const featured=exhibitions.find(e=>e.slug===site.featuredExhibition)||exhibitions[0];
const activeCalls=calls.filter(c=>c.status==='open' && (!c.deadline||Date.parse(c.deadline)>Date.now()) && c.submissionUrl);
---
<Layout>
  <section class="hero wrap">
    <div class="hero-copy"><p class="eyebrow">Burrito · Artist & event collective</p><h1>For artists.<br/>By artists<span class="green">.</span></h1><p class="hero-description">We put on shows,<br/>release art, and meet up.</p><p class="muted hero-note">Run by artists, since 2021.</p><div class="hero-actions"><a class="button" href={`/exhibitions/${featured.slug}/`}>See the latest exhibition <span aria-hidden="true">↗</span></a><a class="text-link" href="/open-calls/">Submit work <span aria-hidden="true">↗</span></a></div><div class="hero-bottom"><img class="brand-globe" src="/images/logo-2_2.webp" alt="Burrito DAO" width="1200" height="773" /><p>Group shows. Open calls.<br/>Artist interviews.</p></div></div>
    <figure class="hero-art"><a href={`/exhibitions/${featured.slug}/`}><img src={featured.image} alt={featured.imageAlt} width="675" height="900" fetchpriority="high" /><span class="image-label">Latest exhibition <span aria-hidden="true">↗</span></span></a><figcaption><span>{featured.city} · {featured.subtitle}</span><span>{featured.credit}</span></figcaption></figure>
  </section>
  <div class="cities" aria-label="Exhibiting across cities and online"><span>Where we’ve shown work</span><p>New York <i aria-hidden="true">·</i> Miami <i aria-hidden="true">·</i> Denver <i aria-hidden="true">·</i> Chicago <i aria-hidden="true">·</i> Paris <i aria-hidden="true">·</i> Everywhere</p></div>
  <section class="section wrap"><div class="section-heading"><div><p class="eyebrow">Recent exhibitions</p><h2>Shows & gatherings.</h2></div><a class="text-link" href="/exhibitions/">All exhibitions <span aria-hidden="true">↗</span></a></div><div class="exhibition-grid">{exhibitions.slice(0,3).map((e,i)=><ExhibitionCard exhibition={e} index={i}/>)}</div></section>
  <section class="manifesto wrap"><p class="eyebrow">A little about us</p><p class="manifesto-text">Four friends.<br/><span>Now a collective.</span></p><div class="manifesto-bottom"><img class="brand-globe" src="/images/logo-2_2.webp" alt="Burrito DAO" width="1200" height="773" loading="lazy" /><div><p>Burrito started with four friends who met through art online. We curate exhibitions, organize group releases, and invite artists to share their work through open calls.</p><a class="text-link" href="/about/">Meet Burrito <span aria-hidden="true">↗</span></a></div></div></section>
  <section class="partner-strip wrap"><p>The people behind Burrito.</p><a class="text-link" href="/team/">Meet the team ↗</a></section>
  <section class="callout"><div class="wrap callout-inner"><div><p class="eyebrow">Artist submissions</p><h2>Show with us.</h2></div><div><span class="status">{activeCalls.length?'Submissions open':'Between open calls'}</span><p>Find the brief, accepted formats, and deadline for each open call. Past calls are kept here with links to the exhibitions.</p><a class="button cream" href="/open-calls/">{activeCalls.length?'Find your next open call':'Explore open calls'} <span aria-hidden="true">↗</span></a><p class="small-note">Catch the next announcement in the Burrito Bar.</p></div></div></section>
  <section class="section wrap"><div class="section-heading"><div><p class="eyebrow">Drops & objects</p><h2>Releases & card packs.</h2></div><a class="text-link" href="/drops/">Drops & objects <span aria-hidden="true">↗</span></a></div><div class="object-feature"><a class="object-image" href="/drops/artist-card-packs/"><img src="/images/mtg.webp" alt="Burrito’s artist-designed MTG proxy card with artwork by emotionull" loading="lazy" width="900" height="900" /></a><div class="object-copy"><p class="eyebrow">Artist-made / Physical objects</p><h3>Artist-made<br/>MTG proxies.</h3><p>Custom card packs made for our first Magic: The Gathering draft at NFT NYC 2026.</p><a class="text-link" href="/drops/artist-card-packs/">Meet the card packs <span aria-hidden="true">↗</span></a><p class="image-credit">Card artwork by emotionull.</p></div></div></section>
  <section class="partner-strip wrap"><p>Host a show.<br/>Work with Burrito.</p><a class="text-link" href="/contact/">Partner / book us <span aria-hidden="true">↗</span></a></section>
</Layout>
