---
import Layout from '../layouts/Layout.astro';import PageIntro from '../components/PageIntro.astro';import site from '../../content/site.json';
---
<Layout title="Partner / book us" description="Plan an exhibition, live art event, or collaboration with Burrito."><PageIntro eyebrow="Contact / partner" title="Work with Burrito." text="Contact us about an exhibition, event, artist collaboration, or interview." /><section class="wrap contact-grid"><div><p class="eyebrow">Start a conversation</p><h2>Tell us about<br/>your project.</h2><p>Tell us what you’re imagining, where it might happen, and when. If you have a budget or a venue in mind, include that too.</p><div class="contact-links"><a class="text-link" href={`mailto:${site.email}`}>{site.email} ↗</a><a class="text-link" href={site.discord}>Join the Burrito Bar ↗</a><a class="text-link" href="/open-calls/">Looking to submit work? ↗</a></div></div><form class="inquiry-form" id="inquiry"><div class="field"><label for="name">Your name *</label><input id="name" name="name" autocomplete="name" required maxlength="120" /></div><div class="field"><label for="email">Your email *</label><input id="email" name="email" type="email" autocomplete="email" required maxlength="200" /></div><div class="field"><label for="type">What do you have in mind?</label><select name="type" id="type"><option>Exhibition or gallery partnership</option><option>Book an event</option><option>Artist collaboration</option><option>Press or interview</option><option>Something else</option></select></div><div class="field"><label for="message">A little about your idea *</label><textarea id="message" name="message" required minlength="10" maxlength="5000" placeholder="The idea, the place, the timing…"></textarea></div><button class="button" type="submit">Prepare your email <span aria-hidden="true">↗</span></button><p class="small-note" style="margin-top:18px">This opens a draft in your email app. Nothing is sent until you send it. Prefer to write directly? <a href={`mailto:${site.email}`}><u>{site.email}</u></a></p><p class="form-result" id="form-result" role="status" hidden></p><button class="text-link" type="button" id="copy-message" hidden style="background:none;border:0;border-bottom:1px solid;padding:12px 0">Copy enquiry to clipboard</button><noscript><p>Please email <a href={`mailto:${site.email}`}>{site.email}</a> directly.</p></noscript></form></section></Layout>
<script>
const form=document.querySelector<HTMLFormElement>('#inquiry');let draft='';
form?.addEventListener('submit',(event)=>{event.preventDefault();const data=new FormData(form);const name=String(data.get('name')||'').trim(),email=String(data.get('email')||'').trim(),type=String(data.get('type')||''),message=String(data.get('message')||'').trim();draft=`Hi Burrito,\n\n${message}\n\n${name}\n${email}\n\nEnquiry: ${type}`;const result=document.querySelector<HTMLElement>('#form-result');if(result){result.hidden=false;result.textContent='Your email draft is ready. If your email app doesn’t open, copy the enquiry and email contact@burritodao.com.';}document.querySelector('#copy-message')?.removeAttribute('hidden');window.location.href=`mailto:contact@burritodao.com?subject=${encodeURIComponent(type+' — '+name)}&body=${encodeURIComponent(draft)}`;});
document.querySelector('#copy-message')?.addEventListener('click',async()=>{const result=document.querySelector('#form-result');try{await navigator.clipboard.writeText(draft);if(result)result.textContent='Copied. Paste your enquiry into an email to contact@burritodao.com.';}catch{if(result)result.textContent='Your browser couldn’t copy the enquiry. Please copy your message above and email contact@burritodao.com.';}});
</script>
