---
import Layout from '../../layouts/Layout.astro';import artists from '../../../content/artists.json';import exhibitions from '../../../content/exhibitions.json';
export function getStaticPaths(){return artists.map(artist=>({params:{slug:artist.slug},props:{artist}}));}const {artist:a}=Astro.props;const shows=exhibitions.filter(e=>e.artists.includes(a.slug));
---
<Layout title={a.name} description={a.bio} image={a.image}><div class="wrap detail-head"><a class="breadcrumb" href="/artists/">← Meet the artists</a></div><section class="wrap detail-grid"><div><p class="eyebrow">{a.practice}</p><h1>{a.name}</h1><p class="lead">{a.bio}</p><a class="text-link" href={a.url} style="margin-top:30px">Visit the artist on X ↗</a><div class="source-links"><a href={a.source}>From Burrito’s posts ↗</a></div></div><figure><div class="detail-photo"><img src={a.image} alt={a.imageAlt} width="700" height="900" /></div><figcaption class="caption">{a.name} · {a.work}</figcaption></figure></section><section class="wrap page-content"><div class="related"><h2>With Burrito</h2>{shows.map(e=><a class="journal-row" href={`/exhibitions/${e.slug}/`}><span class="eyebrow">{e.city} · {e.year}</span><div><h3>{e.title}</h3><p>{e.summary}</p></div><span aria-hidden="true">↗</span></a>)}{a.slug==='emotionull'&&<a class="text-link" href="/journal/emotionull/">Read the 2021 interview ↗</a>}</div></section></Layout>
