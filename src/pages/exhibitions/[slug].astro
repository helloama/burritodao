---
import Layout from '../../layouts/Layout.astro';
import exhibitions from '../../../content/exhibitions.json';
import artists from '../../../content/artists.json';
export function getStaticPaths(){return exhibitions.map(exhibition=>({params:{slug:exhibition.slug},props:{exhibition}}));}
const {exhibition:e}=Astro.props;
const related=artists.filter(a=>e.artists.includes(a.slug));
---
<Layout title={`${e.title} · ${e.city}`} description={e.summary} image={e.image||undefined}>
<div class="wrap detail-head"><a class="breadcrumb" href="/exhibitions/">← All exhibitions</a></div>
<section class="wrap detail-grid"><div><span class="status">{e.status}</span><h1>{e.title}</h1><p class="lead">{e.summary}</p><dl class="facts"><div><dt>Where</dt><dd>{e.venue} · {e.city}</dd></div><div><dt>When</dt><dd>{e.dateLabel}</dd></div><div><dt>Format</dt><dd>{e.type}</dd></div><div><dt>Collective</dt><dd>Burrito</dd></div></dl>{e.rsvp&&e.status==='Upcoming exhibition'&&<a class="button" href={e.rsvp}>RSVP for this event ↗</a>}</div>{e.image?<figure><div class="detail-photo"><img src={e.image} alt={e.imageAlt} width="900" height="900" fetchpriority="high" /></div><figcaption class="caption">{e.credit}</figcaption></figure>:<div class="archive-art" aria-hidden="true"><span>{e.city}</span><strong>{e.year}</strong><i>✳</i></div>}</section>
<section class="wrap"><div class="reading-layout"><aside><p class="eyebrow">About the gathering</p>{e.partners.length>0&&<><p>With</p>{e.partners.map(p=><p>{p}</p>)}</>}</aside><div><div class="prose">{e.body.map(p=><p>{p}</p>)}</div>{e.slug==='return-to-form'&&<a class="button" href="/drops/return-to-form/">Explore the group drop ↗</a>}<div class="source-links">From the archive · {e.sources.filter(s=>!s.includes('burritodao.com')).map((s,i)=><a href={s}>Original post {i+1} ↗</a>)}{e.sources.some(s=>s.includes('burritodao.com'))&&<span>Details preserved from Burrito’s original website.</span>}</div></div></div></section>
{e.gallery.length>0&&<section class="wrap page-content"><p class="eyebrow">From the exhibition</p><div class="gallery-grid">{e.gallery.map(g=><figure><img src={g.image} alt={g.alt} width="800" height="800" loading="lazy" /><figcaption class="caption">{g.credit}</figcaption></figure>)}</div></section>}
{related.length>0&&<section class="wrap page-content"><div class="related"><h2>Meet the artists</h2><div class="names">{related.map(a=><a class="text-link" href={`/artists/${a.slug}/`}>{a.name} ↗</a>)}</div></div></section>}
<section class="partner-strip wrap"><p>Let’s make the next one happen.</p><a class="text-link" href="/contact/">Partner / book us ↗</a></section>
</Layout>
