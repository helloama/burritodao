import Layout from '../layouts/Layout.astro';import PageIntro from '../components/PageIntro.astro';
const services=[['Exhibitions & events','Group shows, live painting, VR demos, and meetups. We work with galleries and venues to bring digital and physical work into the same room.'],['Group releases','We curate collections with multiple artists, sometimes paired with a physical exhibition. Return to Form brought a Rarible release to Lume Studios.'],['Interviews & podcasts','Artists talk about their process and experiences in their own words. Our archive includes written interviews and 122 podcast recordings.'],['Artist-made objects','Projects beyond the exhibition wall, including custom MTG proxy packs for our first community draft.']];
