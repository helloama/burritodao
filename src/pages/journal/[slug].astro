---
import authors from '../../../content/authors.json';
import Layout from '../../layouts/Layout.astro';import posts from '../../../content/journal.json';
export function getStaticPaths(){return posts.map(post=>({params:{slug:post.slug},props:{post}}));}const {post:p}=Astro.props;
const author=authors[p.author as keyof typeof authors];
const articleSchema={'@type':'Article',headline:p.title,description:p.summary,datePublished:p.date,author:{'@type':'Person',name:author.name,...(author.url?{url:new URL(author.url,Astro.site).href}:{})},publisher:{'@id':new URL('/#collective',Astro.site).href},mainEntityOfPage:new URL(Astro.url.pathname,Astro.site).href};
const date=new Date(p.date+'T12:00:00Z').toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric',timeZone:'UTC'});
---
<Layout article={true} structuredData={[articleSchema]} title={p.title} description={p.summary}><section class="page-intro wrap"><p class="eyebrow">From the archive · {p.type}</p><h1>{p.title}</h1><p class="intro-copy">{p.summary}</p></section><article class="wrap page-content"><div class="reading-layout"><aside><p class="eyebrow">Originally published</p><p><time datetime={p.date}>{date}</time></p><p>By {p.author}</p></aside><div class="prose"><div class="article-note">{p.type === "Archived guide" ? "Historical guide — preserved for the archive, not current instructions. Platforms, networks, costs, and links may have changed. Any open call mentioned here is closed. Images and embedded tutorials from the original page are omitted." : "An interview from the Burrito archive. Ages, roles, plans, and statements reflect the original publication date. Introduction and questions have been edited for clarity; interview responses are preserved. Original social embeds are omitted."}</div><p>{p.intro}</p>{p.qa.map(pair=><section><h2>{pair.q}</h2>{pair.a.split('\n\n').map(paragraph=><p>{paragraph}</p>)}</section>)}<aside class="author-bio"><h2>About {author.name}</h2><p>{author.bio}</p>{author.url&&<a class="text-link" href={author.url}>More about {author.name} ↗</a>}</aside><div class="source-links">Originally published as “{p.originalTitle}” on Burrito’s website.</div></div></div></article></Layout>
