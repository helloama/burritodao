---
import Layout from '../../layouts/Layout.astro';import posts from '../../../content/journal.json';
export function getStaticPaths(){return posts.map(post=>({params:{slug:post.slug},props:{post}}));}const {post:p}=Astro.props;
const date=new Date(p.date+'T12:00:00Z').toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric',timeZone:'UTC'});
---
<Layout title={p.title} description={p.summary}><div class="wrap detail-head"><a class="breadcrumb" href="/journal/">← The journal</a></div><section class="page-intro wrap"><p class="eyebrow">From the archive · {p.type}</p><h1>{p.title}</h1><p class="intro-copy">{p.summary}</p></section><article class="wrap page-content"><div class="reading-layout"><aside><p class="eyebrow">Originally published</p><p><time datetime={p.date}>{date}</time></p><p>Interview by {p.author}</p></aside><div class="prose"><div class="article-note">An interview from the Burrito archive. Ages, roles, plans, and statements reflect the original publication date. Introduction and questions have been edited for clarity; interview responses are preserved. Original social embeds are omitted.</div><p>{p.intro}</p>{p.qa.map(pair=><section><h2>{pair.q}</h2>{pair.a.split('\n\n').map(paragraph=><p>{paragraph}</p>)}</section>)}<div class="source-links">Originally published as “{p.originalTitle}” on Burrito’s website.</div></div></div></article></Layout>
