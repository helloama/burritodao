---
import Layout from '../../layouts/Layout.astro';import PageIntro from '../../components/PageIntro.astro';import posts from '../../../content/journal.json';import site from '../../../content/site.json';
---
<Layout title="Journal · Artist conversations" description="Interviews, conversations, and stories from the Burrito collective."><PageIntro eyebrow="The Burrito journal" title="Behind every piece, a person." text="Conversations about making things, finding your people, and figuring it out as you go." /><section class="wrap page-content"><div class="podcast"><div><p class="eyebrow">Pull up a chair</p><h2 style="margin-top:15px">The Burrito podcast</h2><p>More time with the people behind the work. Listen to the collective’s conversations on Spotify.</p></div><a class="button" href={site.podcast}>Listen on Spotify ↗</a></div><p class="eyebrow" style="margin-bottom:25px">From the interview archive / 2021—2022</p>{posts.map(p=><a class="journal-row" href={`/journal/${p.slug}/`}><span class="eyebrow">{new Date(p.date+'T12:00:00Z').toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric',timeZone:'UTC'})}<br/>{p.type}</span><div><h2>{p.title}</h2><p>{p.summary}</p></div><span aria-hidden="true">↗</span></a>)}</section></Layout>
