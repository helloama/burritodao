---
import Layout from '../layouts/Layout.astro';import PageIntro from '../components/PageIntro.astro';import TeamCard from '../components/TeamCard.astro';import team from '../../content/team.json';
const founders=team;
---
<Layout title="The Burrito team" description="Meet Burrito’s founders: Joe, Cat, Null, Trizton, and Mew. Event partnerships, operations, technical work, logistics, and design."><PageIntro eyebrow="Burrito" title="The team." text="The artists and organizers behind the shows, releases, and conversations. Follow each person to see what they’re working on." /><section class="wrap page-content"><h2 class="team-heading">Founders</h2><div class="team-grid">{founders.map(person=><TeamCard person={person}/>)}</div></section><section class="partner-strip wrap"><p>For exhibitions and collaborations.</p><a class="text-link" href="/contact/">Contact Burrito ↗</a></section></Layout>
