---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import team from '../../content/team.json';
---
<Layout title="The team" description="Meet the people behind Burrito, an independent artist and event collective.">
<PageIntro eyebrow="The people behind Burrito" title="Friends making things happen." text="Artists, organizers, and friends. Bringing people together, putting work into the world, and showing up for each other." />
<section class="wrap page-content"><div class="directory-grid">{team.map(person=><article class="directory-card"><a href={person.url}><div class="directory-card-top"><span class="eyebrow">Burrito</span><span aria-hidden="true">↗</span></div><h2>{person.name}</h2><p>Follow on X ↗</p></a></article>)}</div></section>
<section class="partner-strip wrap"><p>Let’s make something together.</p><a class="text-link" href="/contact/">Partner / book us ↗</a></section>
</Layout>
