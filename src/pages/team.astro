---
import Layout from '../layouts/Layout.astro';import PageIntro from '../components/PageIntro.astro';import TeamCard from '../components/TeamCard.astro';import team from '../../content/team.json';
const current=team.filter(p=>p.status!=='previous');const previous=team.filter(p=>p.status==='previous');
---
<Layout title="The Burrito team" description="Meet the artists and organizers behind Burrito, plus previous members of the collective."><PageIntro eyebrow="Burrito" title="The team." text="The artists and organizers behind the shows, releases, and conversations. Follow each person to see what they’re working on." /><section class="wrap page-content"><h2 class="team-heading">Current team</h2><div class="team-grid">{current.map(person=><TeamCard person={person}/>)}</div></section><section class="wrap page-content"><h2 class="team-heading">Previous team</h2><p class="team-note">Part of Burrito’s history. Thank you for the work you put into the collective.</p><div class="team-grid">{previous.map(person=><TeamCard person={person}/>)}</div></section><section class="partner-strip wrap"><p>For exhibitions and collaborations.</p><a class="text-link" href="/contact/">Contact Burrito ↗</a></section></Layout>
