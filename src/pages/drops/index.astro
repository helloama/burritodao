---
import LocalImage from '../../components/LocalImage.astro';
import Layout from '../../layouts/Layout.astro';import PageIntro from '../../components/PageIntro.astro';import drops from '../../../content/drops.json';
---
<Layout title="Drops & objects" description="Collective digital releases and artist-made objects from Burrito."><PageIntro eyebrow="Drops & objects" title="Drops & objects." text="Group releases and artist-made card packs. Find the artwork, collection links, and details here." /><section class="wrap page-content"><div class="drops-grid">{drops.map(d=><article class="drop-card"><a class="card-image" href={`/drops/${d.slug}/`}><LocalImage src={d.image} alt={d.imageAlt} width="900" height="900" loading="lazy"/><span class="card-arrow" aria-hidden="true">↗</span></a><p class="eyebrow" style="margin-top:20px">{d.type} · {d.year}</p><h2><a href={`/drops/${d.slug}/`}>{d.title}</a></h2><p>{d.summary}</p><a class="text-link" href={`/drops/${d.slug}/`} style="margin-top:15px">Explore the release ↗</a></article>)}</div></section></Layout>
