---
import LocalImage from '../../components/LocalImage.astro';
import Layout from '../../layouts/Layout.astro';import drops from '../../../content/drops.json';
export function getStaticPaths(){return drops.map(drop=>({params:{slug:drop.slug},props:{drop}}));}const {drop:d}=Astro.props;
---
<Layout title={d.title} description={d.summary} image={d.image}><section class="wrap detail-grid"><div><p class="eyebrow">{d.type} · {d.year}</p><h1>{d.title}</h1><p class="lead">{d.summary}</p><div class="prose" style="margin-top:30px">{d.body.map(p=><p>{p}</p>)}</div><a class="button" href={d.url}>{d.linkLabel} ↗</a><div class="source-links"><a href={d.source}>Original announcement ↗</a></div></div><figure><div class="detail-photo"><LocalImage src={d.image} alt={d.imageAlt} width="900" height="900" /></div><figcaption class="caption">{d.slug==='artist-card-packs'?'Card artwork by emotionull. Artist-made proxy; not an official Magic: The Gathering product.':'Burrito · Return to Form announcement'}</figcaption></figure></section>{d.slug==='artist-card-packs'&&<section class="wrap page-content"><div class="object-feature"><div class="object-image"><LocalImage src="/images/mtg-event-1516.webp" alt="Two artist-designed cards held in a guest’s hand at the Burrito event" width="1050" height="1400" loading="lazy" /></div><div class="object-copy"><p class="eyebrow">From the first draft</p><h2>Art makes<br/>a good gathering.</h2><p>See the cards, the gallery, and the people who brought it together at Lume Studios.</p><a class="text-link" href="/exhibitions/nft-nyc-2026/">See the event photos ↗</a></div></div></section>}</Layout>
