{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build && npm run check",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/images/mtg-event-1513.webp",
      "destination": "https://burritodao.com/images/nygilia-lume.webp",
      "permanent": true
    },
    {
      "source": "/past-events/",
      "destination": "https://burritodao.com/exhibitions/",
      "permanent": true
    },
    {
      "source": "/art-drops/",
      "destination": "https://burritodao.com/drops/",
      "permanent": true
    },
    {
      "source": "/join-the-dao/",
      "destination": "https://burritodao.com/contact/",
      "permanent": true
    },
    {
      "source": "/articles/",
      "destination": "https://burritodao.com/journal/",
      "permanent": true
    },
    {
      "source": "/category/interviews/",
      "destination": "https://burritodao.com/journal/",
      "permanent": true
    },
    {
      "source": "/interview-with-dustn/",
      "destination": "https://burritodao.com/journal/dustn/",
      "permanent": true
    },
    {
      "source": "/interview-artie-handz/",
      "destination": "https://burritodao.com/journal/artie-handz/",
      "permanent": true
    },
    {
      "source": "/interview-with-danil-pan/",
      "destination": "https://burritodao.com/journal/danil-pan/",
      "permanent": true
    },
    {
      "source": "/interview-with-max-kulchinksy/",
      "destination": "https://burritodao.com/journal/max-kulchinsky/",
      "permanent": true
    },
    {
      "source": "/interview-with-cliffballin/",
      "destination": "https://burritodao.com/journal/cliff/",
      "permanent": true
    },
    {
      "source": "/interview-with-emotionull/",
      "destination": "https://burritodao.com/journal/emotionull/",
      "permanent": true
    },
    {
      "source": "/submit-your-art-for-eth-denver-here/",
      "destination": "https://burritodao.com/exhibitions/art-on-tap/",
      "permanent": true
    },
    {
      "source": "/burrito-guides-how-2-mint-on-op/",
      "destination": "https://burritodao.com/journal/how-to-mint-on-op/",
      "permanent": true
    },
    {
      "source": "/manifold-walkthrough/",
      "destination": "https://burritodao.com/journal/manifold-walkthrough/",
      "permanent": true
    },
    {
      "source": "/nfts-how-to-get-involved/",
      "destination": "https://burritodao.com/journal/nfts-how-to-get-involved/",
      "permanent": true
    },
    {
      "source": "/category/tips-tricks/",
      "destination": "https://burritodao.com/journal/",
      "permanent": true
    },
    {
      "source": "/category/articles/",
      "destination": "https://burritodao.com/journal/",
      "permanent": true
    },
    {
      "source": "/artists/",
      "destination": "https://burritodao.com/team/",
      "permanent": true
    },
    {
      "source": "/artists/:slug/",
      "destination": "https://burritodao.com/team/",
      "permanent": true
    },
    {
      "source": "/:path*/",
      "has": [
        {
          "type": "host",
          "value": "burritodao.vercel.app"
        }
      ],
      "destination": "https://burritodao.com/:path*/",
      "permanent": true
    },
    {
      "source": "/:path*/",
      "has": [
        {
          "type": "host",
          "value": "www.burritodao.com"
        }
      ],
      "destination": "https://burritodao.com/:path*/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
